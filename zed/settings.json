// Zed settings, shared between Linux and macOS.
// Docs: https://zed.dev/docs/configuring-zed
// Defaults: run `zed: open default settings` from the command palette.
{
  "base_keymap": "VSCode",
  "cli_default_open_behavior": "new_window",
  "autosave": "on_focus_change",
  "format_on_save": "off",
  "max_tabs": 5,
  "ui_font_size": 20,
  "buffer_font_size": 20,
  "preferred_line_length": 120,
  "auto_signature_help": true,
  "extend_comment_on_newline": false,
  "inlay_hints": {
    "enabled": true,
  },
  "git": {
    "git_gutter": "tracked_files",
    "gutter_debounce": 500,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Installed automatically on a fresh machine
  "auto_install_extensions": {
    "dockerfile": true,
    "git-firefly": true,
    "html": true,
    "mermaid": true,
    "sql": true,
    "toml": true,
  },

  // Panels: navigation left, terminal bottom
  "project_panel": {
    "button": true,
    "dock": "left",
    "git_status": true,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "terminal": {
    "dock": "bottom",
    "shell": { "program": "fish" },
    "env": {
      "EDITOR": "zed --wait",
    },
    "detect_venv": "off",
  },

  // Edit predictions: off by default, enabled per language below
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
  },

  "languages": {
    "Shell Script": {
      "show_edit_predictions": true,
    },
    "JSONC": {
      "show_edit_predictions": true,
    },
    "YAML": {
      "show_edit_predictions": true,
    },
    "Python": {
      "show_edit_predictions": true,
      "language_servers": ["ty", "!basedpyright", "ruff"],
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "code_action": "source.fixAll.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
    "JSON": {
      "preferred_line_length": 500,
    },
    "Markdown": {
      "preferred_line_length": 160,
    },
      // "LaTeX": {
      //   "show_edit_predictions": true,
      // "preferred_line_length": 160,
      // "formatter": {
      //   "command": "latexindent",
      //   "args": ["-", "-y=modifyLineBreaks:{textWrapOptions:{textWrap:1,columns:160}}"],
      //   "stdin": true
      // }
    // },
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 130,
          "lint": {
            "extendSelect": ["I"],
          },
        },
      },
    },
    "ty": {
      "settings": {
        "diagnosticMode": "workspace",
        "inlayHints": {
          "callArgumentNames": false,
        },
      },
    },
    // "texlab": {
    //   "settings": {
    //     "texlab": {
    //       "build": {
    //         // "onSave": true,
    //         "forwardSearchAfter": true,
    //         "executable": "tectonic",
    //         "args": ["-X", "compile", "%f", "--untrusted", "--synctex", "--keep-logs", "--keep-intermediates"],
    //       },
    //     },
    //   },
    // },
  },
}
