// Danish (macOS, no dead keys) with mac-style symbols on AltGr.
// Levels: [ plain, shift, altgr, altgr+shift ]
partial alphanumeric_keys
xkb_symbols "basic" {
    include "dk(mac_nodeadkeys)"

    key <TLDE> { [ dollar, section, onehalf, paragraph ] };
    key <AE07> { [ 7, slash, braceleft, backslash ] };
    key <AE08> { [ 8, parenleft, bracketleft, braceleft ] };
    key <AE09> { [ 9, parenright, bracketright, braceright ] };
    key <AD08> { [ i, I, bar, idotless ] };
};
