# Ghostty (macOS), linked to ~/.config/ghostty/config by install.sh.
# All options: `ghostty +show-config --default --docs` or https://ghostty.org/docs/config

command = /opt/homebrew/bin/fish
shell-integration = fish
window-subtitle = working-directory
font-size = 16
macos-icon-frame = plastic

quick-terminal-animation-duration = 0
keybind = global:opt+¨=toggle_quick_terminal

# One Dark
background = #21252b
foreground = #abb2bf
selection-background = #323844
selection-foreground = #abb2bf
cursor-color = #abb2bf
cursor-text = #abb2bf
cursor-style = bar
palette = 0=#21252b
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf
palette = 8=#767676
palette = 9=#e06c75
palette = 10=#98c379
palette = 11=#e5c07b
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#abb2bf
