# Ghostty (Linux), linked to ~/.config/ghostty/config by install.sh.
# All options: `ghostty +show-config --default --docs` or https://ghostty.org/docs/config

# Keep running in the background so the quick terminal stays available
quit-after-last-window-closed = false
keybind = global:alt+¨=toggle_quick_terminal

# macOS muscle memory: ctrl+backspace deletes to line start (^U), super+c interrupts (^C)
keybind = ctrl+backspace=text:\x15
keybind = super+c=text:\x03
